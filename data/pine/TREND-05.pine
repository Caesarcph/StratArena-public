strategy("TREND-05 Dual Moving Average", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=100, initial_capital=10000, commission_type=strategy.commission.percent, commission_value=0, process_orders_on_close=true)

fast = ta.sma(close, 50)
slow = ta.sma(close, 200)

float pos = fast > slow ? 1.0 : 0.0

plot(fast, "SMA 50", color=color.blue)
plot(slow, "SMA 200", color=color.orange)

if pos > 0
    strategy.entry("Long", strategy.long)
else
    strategy.close_all()
