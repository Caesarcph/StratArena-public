//@version=5
// TREND-12 MACD Strategy — Quant Arena (https://quantarenas.com/code/)
// Converted from the Python implementation used on the site. Daily timeframe. Not investment advice.
// Converted by hand from Python and not compiled in TradingView by us: please report problems.
strategy("TREND-12 MACD Strategy", overlay=false, default_qty_type=strategy.percent_of_equity, default_qty_value=100, initial_capital=10000, commission_type=strategy.commission.percent, commission_value=0, process_orders_on_close=true)

fastP   = input.int(12, "Fast", minval=1)
slowP   = input.int(26, "Slow", minval=1)
signalP = input.int(9, "Signal", minval=1)

macdLine = ta.ema(close, fastP) - ta.ema(close, slowP)
sigLine = ta.ema(macdLine, signalP)
hist = macdLine - sigLine

warmup = slowP + signalP

pos = bar_index >= warmup and macdLine > sigLine ? 1.0 : 0.0

plot(macdLine, "MACD", color=color.blue)
plot(sigLine, "Signal", color=color.orange)
plot(hist, "Histogram", color=color.gray, style=plot.style_columns)
hline(0, "Zero", color=color.silver)

if pos > 0
    strategy.entry("Long", strategy.long)
else
    strategy.close_all()
