//@version=5
// VOL-01 Volatility Breakout — Quant Arena (https://quantarenas.com/code/)
// Converted from the Python implementation used on the site. Daily timeframe. Not investment advice.
// Converted by hand from Python and not compiled in TradingView by us: please report problems.
strategy("VOL-01 Volatility Breakout", overlay=false, default_qty_type=strategy.percent_of_equity, default_qty_value=100, initial_capital=10000, commission_type=strategy.commission.percent, commission_value=0, process_orders_on_close=true)
// Long when the daily return exceeds 1.5x the 20-bar std of returns; flat on any negative return.

ret = nz(close / close[1] - 1)   // first bar return is 0, as in the Python fillna(0)
vol = ta.stdev(ret, 20, false)
entry = ret > vol * 1.5
exitSignal = ret < 0

var float pos = 0.0
if bar_index >= 1
    if entry
        pos := 1.0
    else if exitSignal
        pos := 0.0

plot(ret * 100, "Return %", color=color.blue, style=plot.style_columns)
plot(vol * 1.5 * 100, "1.5 x vol %", color=color.orange)

if pos > 0
    strategy.entry("Long", strategy.long)
else
    strategy.close_all()
