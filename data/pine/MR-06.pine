//@version=5
// MR-06 Z-Score Mean Reversion — Quant Arena (https://quantarenas.com/code/)
// Converted from the Python implementation used on the site. Daily timeframe. Not investment advice.
// Converted by hand from Python and not compiled in TradingView by us: please report problems.
strategy("MR-06 Z-Score Mean Reversion", overlay=false, default_qty_type=strategy.percent_of_equity, default_qty_value=100, initial_capital=10000, commission_type=strategy.commission.percent, commission_value=0, process_orders_on_close=true)
// z = (close - SMA) / sample std. Filters: annualized vol inside [min, max] and price within
// a threshold of the 200-bar SMA. Once in a trade only the z-score exit applies.

lookback        = input.int(20, "Lookback", minval=2)
entryZ          = input.float(2.0, "Entry z")
exitZ           = input.float(0.5, "Exit z")
volFilter       = input.bool(true, "Vol filter")
trendFilter     = input.bool(true, "Trend filter")
minVol          = input.float(0.10, "Min annualized vol")
maxVol          = input.float(0.50, "Max annualized vol")
trendThreshold  = input.float(0.10, "Trend threshold")

ma = ta.sma(close, lookback)
sd = ta.stdev(close, lookback, false)
zScore = (close - ma) / sd

ret = close / close[1] - 1
annVol = ta.stdev(ret, lookback, false) * math.sqrt(252)
volOk = volFilter ? (annVol > minVol and annVol < maxVol) : true

ma200 = ta.sma(close, 200)
trendNeutral = trendFilter ? (math.abs(close / ma200 - 1) < trendThreshold) : true

var float pos = 0.0
if bar_index >= 200
    canTrade = volOk and trendNeutral
    if pos == 0
        if canTrade and zScore < -entryZ
            pos := 1.0
        else
            pos := 0.0
    else
        if zScore > -exitZ
            pos := 0.0
        else
            pos := 1.0

plot(zScore, "Z-score", color=color.blue)
hline(-entryZ, "Entry", color=color.green)
hline(-exitZ, "Exit", color=color.gray)

if pos > 0
    strategy.entry("Long", strategy.long)
else
    strategy.close_all()
