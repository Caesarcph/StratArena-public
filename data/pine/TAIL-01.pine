//@version=5
// TAIL-01 Crisis Alpha — Quant Arena (https://quantarenas.com/code/)
// Converted from the Python implementation used on the site. Daily timeframe. Not investment advice.
// Converted by hand from Python and not compiled in TradingView by us: please report problems.
// Note: the Python returns -1 (short) whenever 20-bar realised volatility exceeds the threshold and 0 otherwise; it never
// goes long and does not read allow_short. This script therefore always shorts in that state (no Allow short input).
strategy("TAIL-01 Crisis Alpha", overlay=false, default_qty_type=strategy.percent_of_equity, default_qty_value=100, initial_capital=10000, commission_type=strategy.commission.percent, commission_value=0, process_orders_on_close=true)

lookback = input.int(20, "Lookback", minval=2)
threshold = input.float(0.3, "Annualised vol threshold")

ret = nz(close / close[1] - 1)
realized = ta.stdev(ret, lookback, false) * math.sqrt(252)

float pos = realized > threshold ? -1.0 : 0.0

plot(realized, "Realised vol", color=color.blue)
hline(threshold, "Threshold", color=color.red)

if pos < 0
    strategy.entry("Short", strategy.short)
else
    strategy.close_all()
