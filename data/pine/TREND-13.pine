//@version=5
// TREND-13 Triple Moving Average — Quant Arena (https://quantarenas.com/code/)
// Converted from the Python implementation used on the site. Daily timeframe. Not investment advice.
// Converted by hand from Python and not compiled in TradingView by us: please report problems.
strategy("TREND-13 Triple Moving Average", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=100, initial_capital=10000, commission_type=strategy.commission.percent, commission_value=0, process_orders_on_close=true)
// Long when short > medium > long SMA; flat when short < medium < long; otherwise hold previous.

shortWindow  = input.int(50, "Short window", minval=1)
mediumWindow = input.int(100, "Medium window", minval=1)
longWindow   = input.int(200, "Long window", minval=1)

shortMa  = ta.sma(close, shortWindow)
mediumMa = ta.sma(close, mediumWindow)
longMa   = ta.sma(close, longWindow)

var float pos = 0.0
if bar_index >= 1
    if shortMa > mediumMa and mediumMa > longMa
        pos := 1.0
    else if shortMa < mediumMa and mediumMa < longMa
        pos := 0.0

plot(shortMa, "Short SMA", color=color.blue)
plot(mediumMa, "Medium SMA", color=color.orange)
plot(longMa, "Long SMA", color=color.red)

if pos > 0
    strategy.entry("Long", strategy.long)
else
    strategy.close_all()
