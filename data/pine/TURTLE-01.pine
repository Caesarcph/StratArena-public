//@version=5
// TURTLE-01 Turtle Trading — Quant Arena (https://quantarenas.com/code/)
// Converted from the Python implementation used on the site. Daily timeframe. Not investment advice.
// Converted by hand from Python and not compiled in TradingView by us: please report problems.
strategy("TURTLE-01 Turtle Trading", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=100, initial_capital=10000, commission_type=strategy.commission.percent, commission_value=0, process_orders_on_close=true)
// Long-only. The Python uses closing prices for the channels (not highs/lows) and no ATR sizing.

entryWindow = input.int(20, "Entry window", minval=1)
exitWindow  = input.int(10, "Exit window", minval=1)

breakoutHigh = ta.highest(close, entryWindow)[1]
exitLow = ta.lowest(close, exitWindow)[1]

var float pos = 0.0
if bar_index >= 1
    if close > breakoutHigh
        pos := 1.0
    else if close < exitLow
        pos := 0.0

plot(breakoutHigh, "Prior entry-window high (close)", color=color.green)
plot(exitLow, "Prior exit-window low (close)", color=color.red)

if pos > 0
    strategy.entry("Long", strategy.long)
else
    strategy.close_all()
