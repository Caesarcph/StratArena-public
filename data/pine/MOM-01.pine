//@version=5
// MOM-01 Time-Series Momentum — Quant Arena (https://quantarenas.com/code/)
// Converted from the Python implementation used on the site. Daily timeframe. Not investment advice.
// Converted by hand from Python and not compiled in TradingView by us: please report problems.
strategy("MOM-01 Time-Series Momentum", overlay=false, default_qty_type=strategy.percent_of_equity, default_qty_value=100, initial_capital=10000, commission_type=strategy.commission.percent, commission_value=0, process_orders_on_close=true)
// Long-only: long when the 252-bar return is positive, otherwise cash.

mom = close / close[252] - 1
pos = mom > 0 ? 1 : 0

plot(mom * 100, "252-bar momentum %", color=color.blue)
hline(0, "Zero", color=color.gray)

if pos > 0
    strategy.entry("Long", strategy.long)
else
    strategy.close_all()
