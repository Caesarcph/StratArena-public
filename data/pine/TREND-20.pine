//@version=5
// TREND-20 Vortex Indicator — Quant Arena (https://quantarenas.com/code/)
// Converted from the Python implementation used on the site. Daily timeframe. Not investment advice.
// Converted by hand from Python and not compiled in TradingView by us: please report problems.
strategy("TREND-20 Vortex Indicator", overlay=false, default_qty_type=strategy.percent_of_equity, default_qty_value=100, initial_capital=10000, commission_type=strategy.commission.percent, commission_value=0, process_orders_on_close=true)
// Uses real High/Low/Close (the Python receives OHLC data for this strategy).

period = input.int(14, "Period", minval=1)

vmPlus = math.abs(high - low[1])
vmMinus = math.abs(low - high[1])
tr = ta.tr(true)

viPlus = math.sum(vmPlus, period) / math.sum(tr, period)
viMinus = math.sum(vmMinus, period) / math.sum(tr, period)

var float pos = 0.0
if bar_index >= 1
    if viPlus > viMinus
        pos := 1.0
    else if viPlus < viMinus
        pos := 0.0

plot(viPlus, "VI+", color=color.green)
plot(viMinus, "VI-", color=color.red)
hline(1, "1.0", color=color.gray)

if pos > 0
    strategy.entry("Long", strategy.long)
else
    strategy.close_all()
