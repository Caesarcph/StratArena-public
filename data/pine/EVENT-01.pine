//@version=5
// EVENT-01 Trend + Macro Filter — Quant Arena (https://quantarenas.com/code/)
// Converted from the Python implementation used on the site. Daily timeframe. Not investment advice.
// Converted by hand from Python and not compiled in TradingView by us: please report problems.
strategy("EVENT-01 Trend + Macro Filter", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=100, initial_capital=10000, commission_type=strategy.commission.percent, commission_value=0, process_orders_on_close=true)
// Dual SMA trend, flat during the first N bars of each calendar month (macro-event proxy).
// Month rank counts bars from the start of the chart data, like the Python groupby/cumcount.

fastWindow = input.int(50, "Fast window", minval=1)
slowWindow = input.int(200, "Slow window", minval=1)
eventDays  = input.int(3, "Event days", minval=0)

fast = ta.sma(close, fastWindow)
slow = ta.sma(close, slowWindow)
trend = fast > slow

var int monthRank = 0
if bar_index == 0 or month != month[1] or year != year[1]
    monthRank := 0
else
    monthRank += 1
eventBlock = monthRank < eventDays

pos = (trend and not eventBlock) ? 1 : 0

plot(fast, "Fast SMA", color=color.blue)
plot(slow, "Slow SMA", color=color.orange)
bgcolor(eventBlock ? color.new(color.red, 85) : na)

if pos > 0
    strategy.entry("Long", strategy.long)
else
    strategy.close_all()
