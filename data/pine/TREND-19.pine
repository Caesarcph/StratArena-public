//@version=5
// TREND-19 Elder Triple Screen — Quant Arena (https://quantarenas.com/code/)
// Converted from the Python implementation used on the site. Daily timeframe. Not investment advice.
// Converted by hand from Python and not compiled in TradingView by us: please report problems.
strategy("TREND-19 Elder Triple Screen", overlay=false, default_qty_type=strategy.percent_of_equity, default_qty_value=100, initial_capital=10000, commission_type=strategy.commission.percent, commission_value=0, process_orders_on_close=true)

macdFast = input.int(12, "MACD fast", minval=1)
macdSlow = input.int(26, "MACD slow", minval=1)
macdSignal = input.int(9, "MACD signal", minval=1)
emaLong = input.int(50, "EMA long", minval=1)
forceEma = input.int(13, "Force EMA", minval=1)
entryLookback = input.int(20, "Entry lookback", minval=1)

macdLine = ta.ema(close, macdFast) - ta.ema(close, macdSlow)
signalLine = ta.ema(macdLine, macdSignal)
macdHist = macdLine - signalLine
trendUp = macdHist > 0 and close > ta.ema(close, emaLong)

force = ta.change(close)
forceSmoothed = ta.ema(force, forceEma)
pullback = forceSmoothed < 0

breakout = close > ta.highest(close, entryLookback)[1]

var float pos = 0.0
if bar_index >= 1
    if trendUp and pullback and breakout
        pos := 1.0
    else if not trendUp
        pos := 0.0

plot(macdHist, "MACD histogram", color=color.blue, style=plot.style_histogram)
plot(forceSmoothed, "Smoothed force", color=color.orange)
hline(0, "Zero", color=color.gray)

if pos > 0
    strategy.entry("Long", strategy.long)
else
    strategy.close_all()
