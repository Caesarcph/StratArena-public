//@version=5
// TREND-16 Aroon Indicator — Quant Arena (https://quantarenas.com/code/)
// Converted from the Python implementation used on the site. Daily timeframe. Not investment advice.
// Converted by hand from Python and not compiled in TradingView by us: please report problems.
strategy("TREND-16 Aroon Indicator", overlay=false, default_qty_type=strategy.percent_of_equity, default_qty_value=100, initial_capital=10000, commission_type=strategy.commission.percent, commission_value=0, process_orders_on_close=true)

period = input.int(25, "Period", minval=1)
upThreshold = input.float(70, "Up threshold")
downThreshold = input.float(30, "Down threshold")

// Aroon on CLOSE over a window of period+1 bars; ties resolve to the OLDEST extreme (numpy argmax/argmin)
float aroonUp = 0.0
float aroonDown = 0.0
if bar_index >= period
    float hi = close
    float lo = close
    int hk = 0
    int lk = 0
    for k = 1 to period
        if close[k] >= hi
            hi := close[k]
            hk := k
        if close[k] <= lo
            lo := close[k]
            lk := k
    aroonUp := (period - hk) / period * 100.0
    aroonDown := (period - lk) / period * 100.0

var bool inPos = false
if bar_index >= period
    if not inPos
        if aroonUp > upThreshold and aroonDown < downThreshold
            inPos := true
    else
        if aroonUp < 50 or aroonDown > 50
            inPos := false

plot(aroonUp, "Aroon Up", color=color.green)
plot(aroonDown, "Aroon Down", color=color.red)
hline(70, "70", color=color.gray)
hline(30, "30", color=color.gray)
hline(50, "50", color=color.silver)

if inPos
    strategy.entry("Long", strategy.long)
else
    strategy.close_all()
