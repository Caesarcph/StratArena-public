//@version=5
// MOM-03 52-Week High Momentum — Quant Arena (https://quantarenas.com/code/)
// Converted from the Python implementation used on the site. Daily timeframe. Not investment advice.
// Converted by hand from Python and not compiled in TradingView by us: please report problems.
strategy("MOM-03 52-Week High Momentum", overlay=false, default_qty_type=strategy.percent_of_equity, default_qty_value=100, initial_capital=10000, commission_type=strategy.commission.percent, commission_value=0, process_orders_on_close=true)
// Closing-price 52-week high (rolling max of close including today).

lookback       = input.int(252, "Lookback", minval=1)
entryThreshold = input.float(0.95, "Entry threshold")
exitThreshold  = input.float(0.85, "Exit threshold")

high52 = ta.highest(close, lookback)
ratio = close / high52

var float pos = 0.0
if bar_index >= lookback
    if pos == 0
        if ratio >= entryThreshold
            pos := 1.0
        else
            pos := 0.0
    else
        if ratio < exitThreshold
            pos := 0.0
        else
            pos := 1.0

plot(ratio, "Close / 52w high", color=color.blue)
hline(entryThreshold, "Entry", color=color.green)
hline(exitThreshold, "Exit", color=color.red)

if pos > 0
    strategy.entry("Long", strategy.long)
else
    strategy.close_all()
