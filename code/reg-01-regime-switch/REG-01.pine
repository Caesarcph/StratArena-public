//@version=5
// REG-01 Regime Switch — Quant Arena (https://quantarenas.com/code/)
// Converted from the Python implementation used on the site. Daily timeframe. Not investment advice.
// Converted by hand from Python and not compiled in TradingView by us: please report problems.
// Note: the Python code hardcodes 200 / 60 / 0.25 (they are exposed as inputs here with those defaults).
// Position is long when close > SMA and annualised 60-day volatility of daily returns < 25%, else flat
// (no volatility scaling in the code, despite the text description).
strategy("REG-01 Regime Switch", overlay=false, default_qty_type=strategy.percent_of_equity, default_qty_value=100, initial_capital=10000, commission_type=strategy.commission.percent, commission_value=0, process_orders_on_close=true)

trendLen  = input.int(200, "Trend SMA length", minval=2)
volLen    = input.int(60, "Vol lookback", minval=2)
volCutoff = input.float(0.25, "Vol threshold (annualised)", step=0.01)

trendMa = ta.sma(close, trendLen)
ret = close / close[1] - 1
vol = ta.stdev(ret, volLen, false) * math.sqrt(252)

pos = close > trendMa and vol < volCutoff ? 1.0 : 0.0

plot(vol, "Annualised vol", color=color.orange)
hline(volCutoff, "Vol threshold", color=color.red)
plot(pos, "Position", color=color.teal, style=plot.style_stepline)

if pos > 0
    strategy.entry("Long", strategy.long)
else
    strategy.close_all()
