//@version=5
// TREND-02 Donchian Breakout — Quant Arena (https://quantarenas.com/code/)
// Converted from the Python implementation used on the site. Daily timeframe. Not investment advice.
// Converted by hand from Python and not compiled in TradingView by us: please report problems.
// Note: channels are built from CLOSE (55-bar highest close for entry, 20-bar lowest close for exit), compared with the previous bar.
strategy("TREND-02 Donchian Breakout", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=100, initial_capital=10000, commission_type=strategy.commission.percent, commission_value=0, process_orders_on_close=true)

entryLen = 55
exitLen = 20

upperCh = ta.highest(close, entryLen)
lowerCh = ta.lowest(close, exitLen)

var float pos = 0.0
if bar_index >= 1
    if close > upperCh[1]
        pos := 1.0
    else if close < lowerCh[1]
        pos := 0.0

plot(upperCh, "55-bar high close", color=color.green)
plot(lowerCh, "20-bar low close", color=color.red)

if pos > 0
    strategy.entry("Long", strategy.long)
else
    strategy.close_all()
