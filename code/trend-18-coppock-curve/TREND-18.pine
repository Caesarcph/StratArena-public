//@version=5
// TREND-18 Coppock Curve — Quant Arena (https://quantarenas.com/code/)
// Converted from the Python implementation used on the site. Daily timeframe. Not investment advice.
// Converted by hand from Python and not compiled in TradingView by us: please report problems.
strategy("TREND-18 Coppock Curve", overlay=false, default_qty_type=strategy.percent_of_equity, default_qty_value=100, initial_capital=10000, commission_type=strategy.commission.percent, commission_value=0, process_orders_on_close=true)

rocFast = input.int(14, "ROC fast", minval=1)
rocSlow = input.int(11, "ROC slow", minval=1)
wmaWindow = input.int(10, "WMA window", minval=1)

roc1 = close / close[rocFast] - 1
roc2 = close / close[rocSlow] - 1
coppock = ta.wma(roc1 + roc2, wmaWindow)

float pos = coppock > 0 ? 1.0 : 0.0

plot(coppock, "Coppock", color=color.blue)
hline(0, "Zero", color=color.gray)

if pos > 0
    strategy.entry("Long", strategy.long)
else
    strategy.close_all()
