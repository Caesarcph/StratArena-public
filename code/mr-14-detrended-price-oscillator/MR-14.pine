//@version=5
// MR-14 Detrended Price Oscillator — Quant Arena (https://quantarenas.com/code/)
// Converted from the Python implementation used on the site. Daily timeframe. Not investment advice.
// Converted by hand from Python and not compiled in TradingView by us: please report problems.
strategy("MR-14 Detrended Price Oscillator", overlay=false, default_qty_type=strategy.percent_of_equity, default_qty_value=100, initial_capital=10000, commission_type=strategy.commission.percent, commission_value=0, process_orders_on_close=true)

period = input.int(20, "Period", minval=2)
entryLevel = input.float(-2.0, "Entry level (%)")
exitLevel = input.float(0.0, "Exit level (%)")

shift = int(period / 2) + 1
sma = ta.sma(close, period)
dpo = close[shift] - sma
dpoPct = dpo / sma * 100

var float pos = 0.0
if bar_index >= 1
    if pos == 0
        if dpoPct < entryLevel
            pos := 1.0
    else
        if dpoPct > exitLevel
            pos := 0.0

plot(dpoPct, "DPO %", color=color.blue)
hline(entryLevel, "Entry", color=color.green)
hline(exitLevel, "Exit", color=color.gray)

if pos > 0
    strategy.entry("Long", strategy.long)
else
    strategy.close_all()
