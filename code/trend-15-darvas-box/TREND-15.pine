//@version=5
// TREND-15 Darvas Box — Quant Arena (https://quantarenas.com/code/)
// Converted from the Python implementation used on the site. Daily timeframe. Not investment advice.
// Converted by hand from Python and not compiled in TradingView by us: please report problems.
strategy("TREND-15 Darvas Box", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=100, initial_capital=10000, commission_type=strategy.commission.percent, commission_value=0, process_orders_on_close=true)

boxPeriod = input.int(20, "Box period", minval=1)

boxHigh = ta.highest(high, boxPeriod)
boxLow = ta.lowest(low, boxPeriod)

var float pos = 0.0
if bar_index >= 1
    if close > boxHigh[1]
        pos := 1.0
    else if close < boxLow[1]
        pos := 0.0

plot(boxHigh, "Box high", color=color.green)
plot(boxLow, "Box low", color=color.red)

if pos > 0
    strategy.entry("Long", strategy.long)
else
    strategy.close_all()
