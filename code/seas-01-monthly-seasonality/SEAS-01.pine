//@version=5
// SEAS-01 Monthly Seasonality — Quant Arena (https://quantarenas.com/code/)
// Converted from the Python implementation used on the site. Daily timeframe. Not investment advice.
// Converted by hand from Python and not compiled in TradingView by us: please report problems.
// Note: long from November through April, flat May through October ("sell in May"). No parameters in Python.
strategy("SEAS-01 Monthly Seasonality", overlay=false, default_qty_type=strategy.percent_of_equity, default_qty_value=100, initial_capital=10000, commission_type=strategy.commission.percent, commission_value=0, process_orders_on_close=true)

inSeason = month == 11 or month == 12 or month == 1 or month == 2 or month == 3 or month == 4
pos = inSeason ? 1.0 : 0.0

plot(pos, "In season", color=color.teal, style=plot.style_stepline)

if pos > 0
    strategy.entry("Long", strategy.long)
else
    strategy.close_all()
